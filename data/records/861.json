      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 3,
      "source_id": null,
      "text": "It's okay, Amatuka, girls would love it!",
      "html": "It's okay, Amatuka, girls would love it!",
      "credits_raw": "bamboo4",
      "content_sha256": "e4c5df14fe127b75c218d5a2abd4b02cab2be33512b1f17da39bee5b1a85718d",
