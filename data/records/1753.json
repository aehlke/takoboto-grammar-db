      "original_updated_at": null
    },
    {
      "source_id": 7978,
      "position": 2,
      "japanese": "昔の恋人が結婚しようとしまいと、今の私に関係ないことです。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e6%98%94%e3%81%ae\"><span>昔の</span></a><a href=\"https://takoboto.jp/?q=%e6%81%8b%e4%ba%ba%e3%81%8c\"><span>恋人が</span></a><a href=\"https://takoboto.jp/?q=%e7%b5%90%e5%a9%9a%e3%81%97\"><span>結婚し</span></a><a href=\"https://takoboto.jp/?q=%e3%82%88%e3%81%86%e3%81%a8\"><strong>ようと</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%97\"><span>し</span></a><a href=\"https://takoboto.jp/?q=%e3%81%be%e3%81%84\"><strong>まい</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%a8%e3%80%81\"><span>と、</span></a><a href=\"https://takoboto.jp/?q=%e4%bb%8a%e3%81%ae\"><span>今の</span></a><a href=\"https://takoboto.jp/?q=%e7%a7%81%e3%81%ab\"><span>私に</span></a><a href=\"https://takoboto.jp/?q=%e9%96%a2%e4%bf%82%e3%81%aa%e3%81%84%e3%81%93%e3%81%a8%e3%81%a7%e3%81%99%e3%80%82\"><span>関係ないことです。</span></a>",
      "segments": [
        {
          "text": "昔の恋人が結婚し",
          "grammar_highlight": false
        },
        {
          "text": "ようと",
          "grammar_highlight": true
        },
        {
          "text": "し",
          "grammar_highlight": false
        },
        {
          "text": "まい",
          "grammar_highlight": true
        },
        {
          "text": "と、今の私に関係ないことです。",
          "grammar_highlight": false
        }
      ],
      "reading": "むかしのこいびとがけっこんしようとしまいと、いまのわたしにかんけいないことです。",
      "credits_raw": "LR",
      "translations": [
        {
          "language": "en",
          "text": "Whether my childhood sweetheart gets married or not, it's got nothing to do with me now.",
          "html": "<strong>Whether </strong><span>my childhood sweetheart gets married or not, it's got nothing to do with me now. </span>",
          "segments": [
            {
              "text": "Whether ",
              "grammar_highlight": true
            },
            {
              "text": "my childhood sweetheart gets married or not, it's got nothing to do with me now. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 7979,
      "position": 3,
      "japanese": "あの教授は学生がわかろうと分かるまいとかまわず授業を進めて行く",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%82%e3%81%ae\"><span>あの</span></a><a href=\"https://takoboto.jp/?q=%e6%95%99%e6%8e%88%e3%81%af\"><span>教授は</span></a><a href=\"https://takoboto.jp/?q=%e5%ad%a6%e7%94%9f%e3%81%8c%e3%82%8f%e3%81%8b\"><span>学生がわか</span></a><a href=\"https://takoboto.jp/?q=%e3%82%8d%e3%81%86%e3%81%a8\"><strong>ろうと</strong></a><a href=\"https://takoboto.jp/?q=%e5%88%86%e3%81%8b%e3%82%8b\"><span>分かる</span></a><a href=\"https://takoboto.jp/?q=%e3%81%be%e3%81%84\"><strong>まい</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%a8%e3%81%8b%e3%81%be%e3%82%8f%e3%81%9a\"><span>とかまわず</span></a><a href=\"https://takoboto.jp/?q=%e6%8e%88%e6%a5%ad%e3%82%92\"><span>授業を</span></a><a href=\"https://takoboto.jp/?q=%e9%80%b2%e3%82%81%e3%81%a6\"><span>進めて</span></a><a href=\"https://takoboto.jp/?q=%e8%a1%8c%e3%81%8f\"><span>行く</span></a>",
      "segments": [
        {
          "text": "あの教授は学生がわか",
          "grammar_highlight": false
        },
        {
          "text": "ろうと",
          "grammar_highlight": true
        },
        {
          "text": "分かる",
          "grammar_highlight": false
        },
        {
          "text": "まい",
          "grammar_highlight": true
        },
        {
          "text": "とかまわず授業を進めて行く",
          "grammar_highlight": false
        }
      ],
      "reading": "あのきょうじゅはがくせいがわかろうとわかるまいとかまわずじゅぎょうをすすめていく",
      "credits_raw": "LR",
      "translations": [
        {
          "language": "en",
          "text": "That professor keeps lecturing, regardless of whether his students understand it or not.",
          "html": "<span>That professor keeps lecturing, </span><strong>regardless of whether </strong><span>his students understand it or not. </span>",
          "segments": [
            {
              "text": "That professor keeps lecturing, ",
              "grammar_highlight": false
            },
            {
              "text": "regardless of whether ",
              "grammar_highlight": true
            },
            {
              "text": "his students understand it or not. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
