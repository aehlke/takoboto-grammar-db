    {
      "source_id": 7977,
      "position": 1,
      "japanese": "パーティに参加しようがするまいが、会費は全員払わなければならない。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%83%91%e3%83%bc%e3%83%86%e3%82%a3%e3%81%ab\"><span>パーティに</span></a><a href=\"https://takoboto.jp/?q=%e5%8f%82%e5%8a%a0%e3%81%97\"><span>参加し</span></a><a href=\"https://takoboto.jp/?q=%e3%82%88%e3%81%86%e3%81%8c\"><strong>ようが</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%99%e3%82%8b\"><span>する</span></a><a href=\"https://takoboto.jp/?q=%e3%81%be%e3%81%84%e3%81%8c\"><strong>まいが</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%81\"><span>、</span></a><a href=\"https://takoboto.jp/?q=%e4%bc%9a%e8%b2%bb%e3%81%af\"><span>会費は</span></a><a href=\"https://takoboto.jp/?q=%e5%85%a8%e5%93%a1%e6%89%95%e3%82%8f%e3%81%aa%e3%81%91%e3%82%8c%e3%81%b0%e3%81%aa%e3%82%89%e3%81%aa%e3%81%84%e3%80%82\"><span>全員払わなければならない。</span></a>",
      "segments": [
        {
          "text": "パーティに参加し",
          "grammar_highlight": false
        },
        {
          "text": "ようが",
          "grammar_highlight": true
        },
        {
          "text": "する",
          "grammar_highlight": false
        },
        {
          "text": "まいが",
          "grammar_highlight": true
        },
        {
          "text": "、会費は全員払わなければならない。",
          "grammar_highlight": false
        }
      ],
      "reading": "パーティにさんかしようがするまいが、かいひはぜんいんはらわなければならない。",
      "credits_raw": "LR",
      "translations": [
        {
          "language": "en",
          "text": "Regardless of whether or not you go to the parties, all members must pay the membership fees.",
          "html": "<strong>Regardless of whether or not </strong><span>you go to the parties, </span><span>all members must pay the membership fees. </span>",
          "segments": [
            {
              "text": "Regardless of whether or not ",
              "grammar_highlight": true
            },
            {
              "text": "you go to the parties, all members must pay the membership fees. ",
              "grammar_highlight": false
            }
          ]
        }
