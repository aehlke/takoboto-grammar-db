      "content_sha256": "6396d01dfe085f0aa6e5dd6065bbc553a6263cd6004c3f3a5b2ff660c8887f34",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 13,
      "source_id": null,
      "text": "私が今から考えているのとおりに起こっています。\nIt's happening exactly as I think it is.",
      "html": "私が今から考えているのとおりに起こっています。<br/>It's happening exactly as I think it is.",
