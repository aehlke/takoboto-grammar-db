      "original_updated_at": null
    },
    {
      "position": 11,
      "source_id": null,
      "text": "in these examples can か・・・かないこのうちに be replaced by かともうったら?",
      "html": "in these examples can か・・・かないこのうちに be replaced by かともうったら?",
