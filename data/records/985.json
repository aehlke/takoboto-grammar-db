      "content_sha256": "3615941e679b51b09f040c21e0cb9d489b7741324a3d585b7468e64188638eb1",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 2,
      "source_id": null,
      "text": "bamboo - since that seems to be a different grammar construct, i added it as a new item kadoukanouchini and put miki's example there. This one should then be noted as \"rare\" - but it may turn up in the JLPT test...",
      "html": "bamboo - since that seems to be a different grammar construct, i added it as a new item kadoukanouchini and put miki's example there. This one should then be noted as \"rare\" - but it may turn up in the JLPT test...",
