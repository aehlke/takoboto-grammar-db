      "segments": [
        {
          "text": "その一行が出発する",
          "grammar_highlight": false
        },
        {
          "text": "か",
          "grammar_highlight": true
        },
        {
          "text": "し",
          "grammar_highlight": false
        },
        {
          "text": "ないかのうちに、",
          "grammar_highlight": true
        },
        {
          "text": "雨が振り出した。",
          "grammar_highlight": false
