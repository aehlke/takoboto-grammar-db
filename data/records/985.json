    },
    {
      "position": 12,
      "source_id": null,
      "text": "I moved ex #6923, #6924 and #6925 from sister entry 〜か〜ないかのうちに. After that I changed #6924 which was almost the same than #318.",
      "html": "I moved ex #6923, #6924 and #6925 from sister entry 〜か〜ないかのうちに. After that I changed #6924 which was almost the same than #318.",
