      "source_id": 7038,
      "position": 0,
      "japanese": "本日の営業は午後7時をもって終了いたします。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e6%9c%ac%e6%97%a5%e3%81%ae\"><span>本日の</span></a><a href=\"https://takoboto.jp/?q=%e5%96%b6%e6%a5%ad%e3%81%af\"><span>営業は</span></a><a href=\"https://takoboto.jp/?q=%e5%8d%88%e5%be%8c7\"><span>午後7</span></a><a href=\"https://takoboto.jp/?q=%e6%99%82\"><span>時</span></a><a href=\"https://takoboto.jp/?q=%e3%82%92%e3%82%82%e3%81%a3%e3%81%a6\"><strong>をもって</strong></a><a href=\"https://takoboto.jp/?q=%e7%b5%82%e4%ba%86%e3%81%84%e3%81%9f%e3%81%97%e3%81%be%e3%81%99%e3%80%82\"><span>終了いたします。</span></a>",
      "segments": [
        {
          "text": "本日の営業は午後7時",
          "grammar_highlight": false
        },
        {
          "text": "をもって",
          "grammar_highlight": true
        },
        {
          "text": "終了いたします。",
          "grammar_highlight": false
        }
      ],
