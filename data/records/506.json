      "segments": [
        {
          "text": "小説家は時代小説を書く",
          "grammar_highlight": false
        },
        {
          "text": "に当たり",
          "grammar_highlight": true
        },
        {
          "text": "、その時代の歴史を詳しく調べた。",
          "grammar_highlight": false
        }
      ],
      "reading": "しょうせつかはじだいしょうせつをかくにあたり、そのじだいのれきしをくわしくしらべた。",
