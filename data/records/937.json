  "comments": [
    {
      "position": 0,
      "source_id": null,
      "text": "Does anybody know where a good list of spoken versus writing style words (as the case seems to be here, with takadaka and seizei) can be found?",
      "html": "Does anybody know where a good list of spoken versus writing style words (as the case seems to be here, with takadaka and seizei) can be found?",
