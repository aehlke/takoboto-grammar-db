      "content_sha256": "3facf0fc45c45d0e201f78dfa31bbfcd9035e4104909ea278f6d5272c64cc491",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 8,
      "source_id": null,
      "text": "Same as [koto ni naru], we should merge both articles. Which syntax do we use: seperated by space or in one word?",
      "html": "Same as [koto ni naru], we should merge both articles. Which syntax do we use: seperated by space or in one word?",
