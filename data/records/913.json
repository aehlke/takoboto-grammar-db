    },
    {
      "position": 1,
      "source_id": null,
      "text": "I'm not sure about this example - it may be the same as the standard ninaru.",
      "html": "I'm not sure about this example - it may be the same as the standard ninaru.",
      "credits_raw": "Amatuka",
      "content_sha256": "b63d05cfacfa5c2d028eea1758633563fb0299747bc724accc3f5fc40c274c2d",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 2,
      "source_id": null,
      "text": "Yeah, it looks ninaru and kotoninaru is the same.",
      "html": "Yeah, it looks ninaru and kotoninaru is the same.",
