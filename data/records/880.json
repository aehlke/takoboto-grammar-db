        {
          "text": "花子はそのとき東京行きの高速バスの上だった",
          "grammar_highlight": false
        }
      ],
      "reading": "たろうははなこのゆくえをおってやまにのぼりはじめた。いまはそれはさておき、はなこはそのときとうきょういきのこうそくバスのうえだった",
      "credits_raw": "bamboo4, dc",
      "translations": [
        {
          "language": "en",
          "text": "In pursuit of Hanako, Taro started to climb the mountain. Leaving that aside for the moment, Hanako at that moment was on a highway bus heading out to Tokyo.",
          "html": "<span>In pursuit of Hanako, Taro started to climb the mountain. </span><strong>Leaving that aside </strong><span>for the moment, Hanako at that moment was on a highway bus heading out to Tokyo. </span>",
          "segments": [
            {
              "text": "In pursuit of Hanako, Taro started to climb the mountain. ",
              "grammar_highlight": false
            },
            {
              "text": "Leaving that aside ",
              "grammar_highlight": true
            },
            {
              "text": "for the moment, Hanako at that moment was on a highway bus heading out to Tokyo. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
