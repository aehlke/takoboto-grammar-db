      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e5%bd%bc%e3%82%92\"><span>彼を</span></a><a href=\"https://takoboto.jp/?q=%e9%9b%87%e3%81%86%e3%81%93%e3%81%a8%e3%81%af\"><span>雇うことは</span></a><a href=\"https://takoboto.jp/?q=%e8%aa%b0%e3%82%82\"><span>誰も</span></a><a href=\"https://takoboto.jp/?q=%e9%9b%87%e3%82%8f%e3%81%aa%e3%81%84%e3%81%93%e3%81%a8\"><span>雇わないこと</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e7%ad%89%e3%81%97%e3%81%84\"><strong>に等しい</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%82\"><span>。</span></a>",
      "segments": [
