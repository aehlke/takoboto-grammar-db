      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e6%9c%ac%e3%81%ae\"><span>本の</span></a><a href=\"https://takoboto.jp/?q=%e5%bf%83%e3%81%ab\"><span>心に</span></a><a href=\"https://takoboto.jp/?q=%e5%af%be%e3%81%99%e3%82%8b\"><span>対する</span></a><a href=\"https://takoboto.jp/?q=%e9%96%a2%e4%bf%82%e3%81%af%e3%80%81\"><span>関係は、</span></a><a href=\"https://takoboto.jp/?q=%e9%a3%9f%e7%b3%a7%e3%81%ae\"><span>食糧の</span></a><a href=\"https://takoboto.jp/?q=%e4%bd%93%e3%81%ab\"><span>体に</span></a><a href=\"https://takoboto.jp/?q=%e5%af%be%e3%81%99%e3%82%8b\"><span>対する</span></a><a href=\"https://takoboto.jp/?q=%e9%96%a2%e4%bf%82\"><span>関係</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e7%ad%89%e3%81%97%e3%81%84\"><strong>に等しい</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%82\"><span>。</span></a>",
      "segments": [
