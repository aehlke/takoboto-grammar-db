      "japanese": "水と魚の関係は、空気と人間の関係に等しい。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e6%b0%b4%e3%81%a8\"><span>水と</span></a><a href=\"https://takoboto.jp/?q=%e9%ad%9a%e3%81%ae\"><span>魚の</span></a><a href=\"https://takoboto.jp/?q=%e9%96%a2%e4%bf%82%e3%81%af%e3%80%81\"><span>関係は、</span></a><a href=\"https://takoboto.jp/?q=%e7%a9%ba%e6%b0%97%e3%81%a8\"><span>空気と</span></a><a href=\"https://takoboto.jp/?q=%e4%ba%ba%e9%96%93%e3%81%ae\"><span>人間の</span></a><a href=\"https://takoboto.jp/?q=%e9%96%a2%e4%bf%82\"><span>関係</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e7%ad%89%e3%81%97%e3%81%84\"><strong>に等しい</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%82\"><span>。</span></a>",
      "segments": [
        {
          "text": "水と魚の関係は、空気と人間の関係",
          "grammar_highlight": false
        },
        {
          "text": "に等しい",
          "grammar_highlight": true
        },
        {
          "text": "。",
          "grammar_highlight": false
        }
      ],
      "reading": "みずとさかなのかんけいは、くうきとにんげんのかんけいにひとしい。",
      "credits_raw": "dc",
      "translations": [
        {
          "language": "en",
          "text": "Water is to fish what air is to man.",
          "html": "<span>Water is to fish what air is to man. </span>",
          "segments": [
            {
              "text": "Water is to fish what air is to man. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
