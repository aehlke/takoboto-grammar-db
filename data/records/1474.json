          "text": "真実と科学者の関係は言葉と詩人の関係",
          "grammar_highlight": false
        },
        {
          "text": "に等しい",
          "grammar_highlight": true
        },
        {
          "text": "としばしば言われてきた。",
          "grammar_highlight": false
        }
