  "comments": [
    {
      "position": 0,
      "source_id": null,
      "text": "I think we could omit this ukkari from the jgram, since this is actually a word, and not a grammatical phrase. Otherwise, if we start adding words (like adverbs), then there would just an enormous number to add. Words like \"bonyari\" would also have to be added, which might be a pain.",
      "html": "I think we could omit this ukkari from the jgram, since this is actually a word, and not a grammatical phrase. Otherwise, if we start adding words (like adverbs), then there would just an enormous number to add. Words like \"bonyari\" would also have to be added, which might be a pain.",
      "credits_raw": "nhk9",
      "content_sha256": "0f86380af9471177bce34d1ee66fc874b57f11610d6d881001619164babfa399",
      "original_created_at": null,
