    {
      "source_id": 4709,
      "position": 6,
      "japanese": "自分の本当の感情を見せることは、日本では美徳とは考えられていない。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%87%aa%e5%88%86%e3%81%ae\"><span>自分の</span></a><a href=\"https://takoboto.jp/?q=%e6%9c%ac%e5%bd%93%e3%81%ae\"><span>本当の</span></a><a href=\"https://takoboto.jp/?q=%e6%84%9f%e6%83%85%e3%82%92\"><span>感情を</span></a><a href=\"https://takoboto.jp/?q=%e8%a6%8b%e3%81%9b%e3%82%8b\"><strong>見せる</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%93%e3%81%a8%e3%81%af%e3%80%81\"><span>ことは、</span></a><a href=\"https://takoboto.jp/?q=%e6%97%a5%e6%9c%ac%e3%81%a7%e3%81%af\"><span>日本では</span></a><a href=\"https://takoboto.jp/?q=%e7%be%8e%e5%be%b3%e3%81%a8%e3%81%af\"><span>美徳とは</span></a><a href=\"https://takoboto.jp/?q=%e8%80%83%e3%81%88%e3%82%89%e3%82%8c%e3%81%a6%e3%81%84%e3%81%aa%e3%81%84%e3%80%82\"><span>考えられていない。</span></a>",
      "segments": [
        {
          "text": "自分の本当の感情を",
          "grammar_highlight": false
        },
        {
          "text": "見せる",
          "grammar_highlight": true
        },
        {
          "text": "ことは、日本では美徳とは考えられていない。",
          "grammar_highlight": false
        }
      ],
      "reading": "じぶんのほんとうのかんじょうをみせることは、にほんではびとくとはかんがえられていない。",
      "credits_raw": "Miki",
      "translations": [
        {
          "language": "en",
          "text": "Showing your real feelings is not considered a virtue in Japan.",
          "html": "<span>Showing your real feelings is not considered a virtue in Japan. </span>",
          "segments": [
            {
              "text": "Showing your real feelings is not considered a virtue in Japan. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
