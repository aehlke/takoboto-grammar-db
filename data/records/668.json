      "original_updated_at": null
    },
    {
      "source_id": 8775,
      "position": 11,
      "japanese": "それは説明しがたい。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%82%8c%e3%81%af%e8%aa%ac%e6%98%8e%e3%81%97\"><span>それは説明し</span></a><a href=\"https://takoboto.jp/?q=%e3%81%8c%e3%81%9f%e3%81%84\"><strong>がたい</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%82\"><span>。</span></a>",
      "segments": [
        {
          "text": "それは説明し",
          "grammar_highlight": false
        },
        {
          "text": "がたい",
