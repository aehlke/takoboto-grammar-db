    {
      "source_id": 6390,
      "position": 1,
      "japanese": "日本の大学に入学するのが難しいのに対して、アメリカの大学は卒業するのが難しい。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e6%97%a5%e6%9c%ac%e3%81%ae\"><span>日本の</span></a><a href=\"https://takoboto.jp/?q=%e5%a4%a7%e5%ad%a6%e3%81%ab\"><span>大学に</span></a><a href=\"https://takoboto.jp/?q=%e5%85%a5%e5%ad%a6%e3%81%99%e3%82%8b%e3%81%ae%e3%81%8c\"><span>入学するのが</span></a><a href=\"https://takoboto.jp/?q=%e9%9b%a3%e3%81%97%e3%81%84%e3%81%ae\"><span>難しいの</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e5%af%be%e3%81%97%e3%81%a6\"><strong>に対して</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%81%e3%82%a2%e3%83%a1%e3%83%aa%e3%82%ab%e3%81%ae\"><span>、アメリカの</span></a><a href=\"https://takoboto.jp/?q=%e5%a4%a7%e5%ad%a6%e3%81%af\"><span>大学は</span></a><a href=\"https://takoboto.jp/?q=%e5%8d%92%e6%a5%ad%e3%81%99%e3%82%8b%e3%81%ae%e3%81%8c\"><span>卒業するのが</span></a><a href=\"https://takoboto.jp/?q=%e9%9b%a3%e3%81%97%e3%81%84%e3%80%82\"><span>難しい。</span></a>",
      "segments": [
        {
          "text": "日本の大学に入学するのが難しいの",
          "grammar_highlight": false
        },
        {
          "text": "に対して",
          "grammar_highlight": true
        },
        {
          "text": "、アメリカの大学は卒業するのが難しい。",
          "grammar_highlight": false
        }
      ],
      "reading": "にほんのだいがくににゅうがくするのがむずかしいのにたいして、アメリカのだいがくはそつぎょうするのがむずかしい。",
      "credits_raw": "rubyhatchet",
      "translations": [
        {
          "language": "en",
          "text": "Whereas entering university is difficult in Japan, graduating from university is difficult in America.",
          "html": "<span>Whereas entering university is difficult in Japan, graduating from university is difficult in America. </span>",
          "segments": [
            {
              "text": "Whereas entering university is difficult in Japan, graduating from university is difficult in America. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
