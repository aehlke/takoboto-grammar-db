    {
      "source_id": 6389,
      "position": 0,
      "japanese": "これまで日本は外交に対して、閉鎖的な政策を取ってきた。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%93%e3%82%8c%e3%81%be%e3%81%a7\"><span>これまで</span></a><a href=\"https://takoboto.jp/?q=%e6%97%a5%e6%9c%ac%e3%81%af\"><span>日本は</span></a><a href=\"https://takoboto.jp/?q=%e5%a4%96%e4%ba%a4\"><span>外交</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e5%af%be%e3%81%97%e3%81%a6\"><strong>に対して</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%81\"><span>、</span></a><a href=\"https://takoboto.jp/?q=%e9%96%89%e9%8e%96%e7%9a%84%e3%81%aa\"><span>閉鎖的な</span></a><a href=\"https://takoboto.jp/?q=%e6%94%bf%e7%ad%96%e3%82%92\"><span>政策を</span></a><a href=\"https://takoboto.jp/?q=%e5%8f%96%e3%81%a3%e3%81%a6%e3%81%8d%e3%81%9f%e3%80%82\"><span>取ってきた。</span></a>",
      "segments": [
        {
          "text": "これまで日本は外交",
          "grammar_highlight": false
        },
        {
          "text": "に対して",
          "grammar_highlight": true
        },
        {
          "text": "、閉鎖的な政策を取ってきた。",
          "grammar_highlight": false
        }
