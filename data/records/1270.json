      "segments": [
        {
          "text": "建築デザインの立場",
          "grammar_highlight": false
        },
        {
          "text": "からいうと",
          "grammar_highlight": true
        },
        {
          "text": "、このアプローチにはもっと多くの代案が考えられる。",
          "grammar_highlight": false
        }
      ],
      "reading": "けんちくデザインのたちばからいうと、このアプローチにはもっとおおくのだいあんがかんがえられる。",
      "credits_raw": "dbx",
      "translations": [
        {
          "language": "en",
          "text": "From the standpoint of architectural design, there can be more alternatives to this approach.",
          "html": "<span>From the standpoint of architectural design, there can be more alternatives to this approach. </span>",
