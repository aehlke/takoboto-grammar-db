      "position": 2,
      "japanese": "その映画を見て彼女は感動のあまり涙を流した。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae\"><span>その</span></a><a href=\"https://takoboto.jp/?q=%e6%98%a0%e7%94%bb%e3%82%92\"><span>映画を</span></a><a href=\"https://takoboto.jp/?q=%e8%a6%8b%e3%81%a6\"><span>見て</span></a><a href=\"https://takoboto.jp/?q=%e5%bd%bc%e5%a5%b3%e3%81%af\"><span>彼女は</span></a><a href=\"https://takoboto.jp/?q=%e6%84%9f%e5%8b%95\"><span>感動</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ae%e3%81%82%e3%81%be%e3%82%8a\"><strong>のあまり</strong></a><a href=\"https://takoboto.jp/?q=%e6%b6%99%e3%82%92\"><span>涙を</span></a><a href=\"https://takoboto.jp/?q=%e6%b5%81%e3%81%97%e3%81%9f%e3%80%82\"><span>流した。</span></a>",
      "segments": [
        {
          "text": "その映画を見て彼女は感動",
          "grammar_highlight": false
        },
        {
          "text": "のあまり",
          "grammar_highlight": true
        },
        {
          "text": "涙を流した。",
          "grammar_highlight": false
        }
      ],
      "reading": "そのえいがをみてかのじょはかんどうのあまりなみだをながした。",
      "credits_raw": "dbx",
      "translations": [
        {
          "language": "en",
          "text": "The movie moved her to tears.",
          "html": "<span>The movie moved her to tears. </span>",
          "segments": [
