        },
        {
          "text": "のあまり",
          "grammar_highlight": true
        },
        {
          "text": "、寝込んでしまいました。",
          "grammar_highlight": false
        }
      ],
      "reading": "ちちおやのしをしらされて、かなしみのあまり、ねこんでしまいました。",
