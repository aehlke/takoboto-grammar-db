          "text": "その光景を見て私は恐怖",
          "grammar_highlight": false
        },
        {
          "text": "のあまり",
          "grammar_highlight": true
        },
        {
          "text": "身の毛がよだつ思いだった。",
          "grammar_highlight": false
        }
      ],
      "reading": "そのこうけいをみてわたしはきょうふのあまりみのけがよだつおもいだった。",
      "credits_raw": "dbx",
      "translations": [
        {
