      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 4,
      "source_id": null,
      "text": "Just to clarify, can のあまり only be used with nouns or adjectives (+sa)?",
      "html": "Just to clarify, can のあまり only be used with nouns or adjectives (+sa)?",
