      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 2,
      "source_id": null,
      "text": "With kanji - 余り. See also variant あんまり",
      "html": "With kanji - 余り. See also variant あんまり",
      "credits_raw": "Amatuka",
      "content_sha256": "f326620dabd9a6b7c99c2c8f6d35b9ebd9e61f85ce2cd13ea6b1aaf1e944db7d",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 3,
      "source_id": null,
      "text": "あんまり is often used on its own to mean \"That's too much!\" / \"That's horrible!\" \"ソレはあんまりよ！\"",
      "html": "あんまり is often used on its own to mean \"That's too much!\" / \"That's horrible!\" \"ソレはあんまりよ！\"",
      "credits_raw": "Amatuka",
