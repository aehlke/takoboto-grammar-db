      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae%e3%83%8b%e3%83%a5%e3%83%bc%e3%82%b9%e3%82%92\"><span>そのニュースを</span></a><a href=\"https://takoboto.jp/?q=%e8%81%9e%e3%81%84%e3%81%9f\"><span>聞いた</span></a><a href=\"https://takoboto.jp/?q=%e6%99%82%e3%80%81%e3%83%8b%e3%82%b3%e3%83%ab%e3%81%af\"><span>時、ニコルは</span></a><a href=\"https://takoboto.jp/?q=%e6%82%b2%e3%81%97%e3%81%bf\"><span>悲しみ</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ae%e3%81%82%e3%81%be%e3%82%8a\"><strong>のあまり</strong></a><a href=\"https://takoboto.jp/?q=%e6%88%91%e3%82%92\"><span>我を</span></a><a href=\"https://takoboto.jp/?q=%e5%bf%98%e3%82%8c%e3%81%9f%e3%80%82\"><span>忘れた。</span></a>",
      "segments": [
        {
          "text": "そのニュースを聞いた時、ニコルは悲しみ",
          "grammar_highlight": false
        },
