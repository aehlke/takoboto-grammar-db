      "translations": [
        {
          "language": "en",
          "text": "This job doesn't require experience but it would probably be an advantage.",
          "html": "<span>This job doesn't require experience but it would probably </span><strong>be an advantage. </strong>",
          "segments": [
            {
              "text": "This job doesn't require experience but it would probably ",
              "grammar_highlight": false
