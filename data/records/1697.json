    {
      "source_id": 7165,
      "position": 0,
      "japanese": "試合の結果はともかく,最後までみんなよくがんばった。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%a9%a6%e5%90%88%e3%81%ae\"><span>試合の</span></a><a href=\"https://takoboto.jp/?q=%e7%b5%90%e6%9e%9c%e3%81%af\"><span>結果は</span></a><a href=\"https://takoboto.jp/?q=%e3%81%a8%e3%82%82%e3%81%8b%e3%81%8f%2c\"><strong>ともかく,</strong></a><a href=\"https://takoboto.jp/?q=%e6%9c%80%e5%be%8c%e3%81%be%e3%81%a7%e3%81%bf%e3%82%93%e3%81%aa%e3%82%88%e3%81%8f%e3%81%8c%e3%82%93%e3%81%b0%e3%81%a3%e3%81%9f%e3%80%82\"><span>最後までみんなよくがんばった。</span></a>",
      "segments": [
        {
          "text": "試合の結果は",
          "grammar_highlight": false
        },
        {
          "text": "ともかく,",
          "grammar_highlight": true
        },
        {
          "text": "最後までみんなよくがんばった。",
          "grammar_highlight": false
        }
      ],
      "reading": "しあいのけっかはともかくさいごまでみんなよくがんばった。",
      "credits_raw": "sureshnihon",
      "translations": [
        {
          "language": "en",
          "text": "No matter what the result was, every one has done their best.",
          "html": "<strong>No matter what </strong><span>the result was, every one has done their best. </span>",
          "segments": [
            {
              "text": "No matter what ",
              "grammar_highlight": true
