    {
      "source_id": 7971,
      "position": 1,
      "japanese": "君が来るなり，僕が行くなりしなくてはならない",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e5%90%9b%e3%81%8c\"><span>君が</span></a><a href=\"https://takoboto.jp/?q=%e6%9d%a5%e3%82%8b\"><span>来る</span></a><a href=\"https://takoboto.jp/?q=%e3%81%aa%e3%82%8a\"><strong>なり</strong></a><a href=\"https://takoboto.jp/?q=%ef%bc%8c%e5%83%95%e3%81%8c\"><span>，僕が</span></a><a href=\"https://takoboto.jp/?q=%e8%a1%8c%e3%81%8f%e3%81%aa%e3%82%8a%e3%81%97%e3%81%aa%e3%81%8f%e3%81%a6%e3%81%af%e3%81%aa%e3%82%89%e3%81%aa%e3%81%84\"><span>行くなりしなくてはならない</span></a>",
      "segments": [
        {
          "text": "君が来る",
          "grammar_highlight": false
        },
        {
          "text": "なり",
          "grammar_highlight": true
        },
        {
          "text": "，僕が行くなりしなくてはならない",
          "grammar_highlight": false
        }
      ],
      "reading": "きみがくるなり，ぼくがいくなりしなくてはならない",
      "credits_raw": "LR",
      "translations": [
        {
          "language": "en",
          "text": "Either you must come here or I must go there.",
          "html": "<span>Either you must come here or I must go there. </span>",
