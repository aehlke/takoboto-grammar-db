      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e5%bd%bc%e5%a5%b3%e3%81%af\"><span>彼女は</span></a><a href=\"https://takoboto.jp/?q=%e9%87%91%e3%82%82%e3%81%86%e3%81%91%e3%81%ae%e3%81%93%e3%81%a8\"><span>金もうけのこと</span></a><a href=\"https://takoboto.jp/?q=%e3%81%97%e3%81%8b\"><strong>しか</strong></a><a href=\"https://takoboto.jp/?q=%e8%80%83%e3%81%88%e3%81%aa%e3%81%84%e3%80%82\"><span>考えない。</span></a>",
      "segments": [
        {
          "text": "彼女は金もうけのこと",
          "grammar_highlight": false
        },
        {
          "text": "しか",
          "grammar_highlight": true
