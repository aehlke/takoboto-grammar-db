  "comments": [
    {
      "position": 0,
      "source_id": null,
      "text": "済みません means that one's mind remains unsettled and therefore not 澄む, that is not clear. From 澄む came the concept of 済む meaning \"finishied.\"",
      "html": "済みません means that one's mind remains unsettled and therefore not 澄む, that is not clear. From 澄む came the concept of 済む meaning \"finishied.\"",
      "credits_raw": "bamboo4",
      "content_sha256": "b8e57a7f6b0ea2544186c059b4ae77e5bcb9d1fb5185263812bf9a2996fac2d3",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 1,
