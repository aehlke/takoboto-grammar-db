    {
      "source_id": 3981,
      "position": 3,
      "japanese": "あなたの許可を頂くべきだったでしょうか。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%82%e3%81%aa%e3%81%9f%e3%81%ae\"><span>あなたの</span></a><a href=\"https://takoboto.jp/?q=%e8%a8%b1%e5%8f%af%e3%82%92\"><span>許可を</span></a><a href=\"https://takoboto.jp/?q=%e9%a0%82%e3%81%8f\"><strong>頂く</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%b9%e3%81%8d%e3%81%a0%e3%81%a3%e3%81%9f%e3%81%a7%e3%81%97%e3%82%87%e3%81%86%e3%81%8b%e3%80%82\"><span>べきだったでしょうか。</span></a>",
      "segments": [
        {
          "text": "あなたの許可を",
          "grammar_highlight": false
        },
        {
          "text": "頂く",
          "grammar_highlight": true
        },
        {
          "text": "べきだったでしょうか。",
          "grammar_highlight": false
        }
      ],
      "reading": "あなたのきょかをいただくべきだったでしょうか。",
      "credits_raw": "Miki",
      "translations": [
        {
          "language": "en",
          "text": "Should I have asked your permission?",
          "html": "<span>Should I have asked your permission? </span>",
          "segments": [
            {
