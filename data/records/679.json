      "segments": [
        {
          "text": "「太っている人はみんなダイエットす",
          "grammar_highlight": false
        },
        {
          "text": "べきだ",
          "grammar_highlight": true
        },
        {
          "text": "と思う。」「あなた、私のことを言っているの。」",
