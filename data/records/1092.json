    },
    {
      "position": 8,
      "source_id": null,
      "text": "The note says Description + いかにも but all the examples appear to be いかにも + Description. Should we change that?",
      "html": "The note says Description + いかにも but all the examples appear to be いかにも + Description. Should we change that?",
