    {
      "position": 0,
      "source_id": null,
      "text": "Description + いかにも + evidence to the contrary = seems (but isn't)\nDesciption + いかにも = indeed",
      "html": "Description + いかにも + evidence to the contrary = seems (but isn't)<br/>Desciption + いかにも = indeed",
      "credits_raw": "Ebisu Dave",
      "content_sha256": "194d81617656366026a7403437e02d761fb7a521d02b74e585db2da420f91936",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 1,
      "source_id": null,
      "text": "Edited #2993.",
      "html": "Edited #2993.",
      "credits_raw": "bamboo4",
      "content_sha256": "45ec6fd9f3e84cf7ab62e8b7148925cdaafa94eaf8eb703f0a17621a5488126d",
