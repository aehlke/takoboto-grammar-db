    },
    {
      "position": 9,
      "source_id": null,
      "text": "According to my text, the grammar point is \"いかにもXそうだ\" (including the そうだ）..perhaps \"いかにも\" and \"いかにもXそうだ” should be separated?",
      "html": "According to my text, the grammar point is \"いかにもXそうだ\" (including the そうだ）..perhaps \"いかにも\" and \"いかにもXそうだ” should be separated?",
      "credits_raw": "priest03",
