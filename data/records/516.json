      "segments": [
        {
          "text": "科学上の発見が、世の中を今までよりも良い場所にする",
          "grammar_highlight": false
        },
        {
          "text": "とは限らない",
          "grammar_highlight": true
        },
        {
          "text": "。",
          "grammar_highlight": false
        }
      ],
      "reading": "かがくじょうのはっけんが、よのなかをいままでよりもよいばしょにするとはかぎらない。",
      "credits_raw": "dbx",
      "translations": [
        {
          "language": "en",
          "text": "Scientific discoveries don't always make the world a better place.",
          "html": "<span>Scientific discoveries don't always make the world a better place. </span>",
