      "original_updated_at": null
    },
    {
      "source_id": 3334,
      "position": 6,
      "japanese": "私たちは狂気のテロ活動にかかわる者に寛容でいるつもりはない。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e7%a7%81%e3%81%9f%e3%81%a1%e3%81%af\"><span>私たちは</span></a><a href=\"https://takoboto.jp/?q=%e7%8b%82%e6%b0%97%e3%81%ae%e3%83%86%e3%83%ad\"><span>狂気のテロ</span></a><a href=\"https://takoboto.jp/?q=%e6%b4%bb%e5%8b%95\"><span>活動</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e3%81%8b%e3%81%8b%e3%82%8f%e3%82%8b\"><strong>にかかわる</strong></a><a href=\"https://takoboto.jp/?q=%e8%80%85%e3%81%ab\"><span>者に</span></a><a href=\"https://takoboto.jp/?q=%e5%af%9b%e5%ae%b9%e3%81%a7%e3%81%84%e3%82%8b%e3%81%a4%e3%82%82%e3%82%8a%e3%81%af%e3%81%aa%e3%81%84%e3%80%82\"><span>寛容でいるつもりはない。</span></a>",
      "segments": [
        {
          "text": "私たちは狂気のテロ活動",
          "grammar_highlight": false
        },
        {
          "text": "にかかわる",
          "grammar_highlight": true
        },
        {
          "text": "者に寛容でいるつもりはない。",
          "grammar_highlight": false
        }
      ],
      "reading": "わたしたちはきょうきのテロかつどうにかかわるものにかんようでいるつもりはない。",
      "credits_raw": "dc",
      "translations": [
        {
          "language": "en",
          "text": "We will not tolerate anyone who engages in insane terrorism.",
          "html": "<span>We will not tolerate anyone who engages in insane terrorism. </span>",
          "segments": [
            {
              "text": "We will not tolerate anyone who engages in insane terrorism. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 3335,
      "position": 7,
      "japanese": "製品仕様にかかわる一切の工業所有権はＡＢＣ社に帰属するものとする。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%a3%bd%e5%93%81%e4%bb%95%e6%a7%98\"><span>製品仕様</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e3%81%8b%e3%81%8b%e3%82%8f%e3%82%8b\"><strong>にかかわる</strong></a><a href=\"https://takoboto.jp/?q=%e4%b8%80%e5%88%87%e3%81%ae\"><span>一切の</span></a><a href=\"https://takoboto.jp/?q=%e5%b7%a5%e6%a5%ad%e6%89%80%e6%9c%89%e6%a8%a9%e3%81%af\"><span>工業所有権は</span></a><a href=\"https://takoboto.jp/?q=%ef%bc%a1%ef%bc%a2%ef%bc%a3%e7%a4%be%e3%81%ab\"><span>ＡＢＣ社に</span></a><a href=\"https://takoboto.jp/?q=%e5%b8%b0%e5%b1%9e%e3%81%99%e3%82%8b%e3%82%82%e3%81%ae%e3%81%a8%e3%81%99%e3%82%8b%e3%80%82\"><span>帰属するものとする。</span></a>",
      "segments": [
        {
          "text": "製品仕様",
          "grammar_highlight": false
        },
        {
          "text": "にかかわる",
          "grammar_highlight": true
        },
        {
          "text": "一切の工業所有権はＡＢＣ社に帰属するものとする。",
          "grammar_highlight": false
        }
      ],
      "reading": "せいひんしようにかかわるいっさいのこうぎょうしょゆうけんはえいびーしーしゃにきぞくするものとする。",
      "credits_raw": "dc",
      "translations": [
        {
          "language": "en",
          "text": "Any industrial property rights relating to the Product Specification shall belong to ABC Inc.",
          "html": "<span>Any industrial property rights relating to the Product Specification shall belong to ABC Inc. </span>",
          "segments": [
            {
              "text": "Any industrial property rights relating to the Product Specification shall belong to ABC Inc. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
