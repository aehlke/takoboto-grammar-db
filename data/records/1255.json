      "segments": [
        {
          "text": "戦争は我々すべて",
          "grammar_highlight": false
        },
        {
          "text": "にかかわる",
          "grammar_highlight": true
        },
        {
          "text": "ことだ。",
          "grammar_highlight": false
        }
      ],
      "reading": "せんそうはわれわれすべてにかかわることだ。",
      "credits_raw": "dc",
      "translations": [
        {
