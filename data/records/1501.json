    {
      "source_id": 5331,
      "position": 2,
      "japanese": "きっと彼女の病気はすぐによくなるであろう。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%8d%e3%81%a3%e3%81%a8\"><span>きっと</span></a><a href=\"https://takoboto.jp/?q=%e5%bd%bc%e5%a5%b3%e3%81%ae\"><span>彼女の</span></a><a href=\"https://takoboto.jp/?q=%e7%97%85%e6%b0%97%e3%81%af%e3%81%99%e3%81%90%e3%81%ab\"><span>病気はすぐに</span></a><a href=\"https://takoboto.jp/?q=%e3%82%88%e3%81%8f%e3%81%aa%e3%82%8b\"><span>よくなる</span></a><a href=\"https://takoboto.jp/?q=%e3%81%a7%e3%81%82%e3%82%8d%e3%81%86%e3%80%82\"><strong>であろう。</strong></a>",
      "segments": [
        {
          "text": "きっと彼女の病気はすぐによくなる",
          "grammar_highlight": false
        },
        {
          "text": "であろう。",
          "grammar_highlight": true
        }
      ],
      "reading": "きっとかのじょのびょうきはすぐによくなるであろう。",
      "credits_raw": "Miki",
      "translations": [
        {
          "language": "en",
          "text": "That she will get over her illness soon is certain.",
          "html": "<span>That she </span><strong>will </strong><span>get over her illness soon </span><strong>is certain. </strong>",
          "segments": [
            {
              "text": "That she ",
              "grammar_highlight": false
            },
            {
              "text": "will ",
              "grammar_highlight": true
            },
            {
              "text": "get over her illness soon ",
              "grammar_highlight": false
