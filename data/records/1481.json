    {
      "source_id": 4967,
      "position": 2,
      "japanese": "その仕事は十分にお金になるが、その反面１日に１２時間働かなくてはならない。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae\"><span>その</span></a><a href=\"https://takoboto.jp/?q=%e4%bb%95%e4%ba%8b%e3%81%af\"><span>仕事は</span></a><a href=\"https://takoboto.jp/?q=%e5%8d%81%e5%88%86%e3%81%ab%e3%81%8a\"><span>十分にお</span></a><a href=\"https://takoboto.jp/?q=%e9%87%91%e3%81%ab%e3%81%aa%e3%82%8b%e3%81%8c%e3%80%81\"><span>金になるが、</span></a><a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae%e5%8f%8d%e9%9d%a2\"><strong>その反面</strong></a><a href=\"https://takoboto.jp/?q=%ef%bc%91%e6%97%a5%e3%81%ab\"><span>１日に</span></a><a href=\"https://takoboto.jp/?q=%ef%bc%91%ef%bc%92%e6%99%82%e9%96%93%e5%83%8d%e3%81%8b%e3%81%aa%e3%81%8f%e3%81%a6%e3%81%af%e3%81%aa%e3%82%89%e3%81%aa%e3%81%84%e3%80%82\"><span>１２時間働かなくてはならない。</span></a>",
      "segments": [
        {
          "text": "その仕事は十分にお金になるが、",
          "grammar_highlight": false
        },
        {
          "text": "その反面",
          "grammar_highlight": true
        },
        {
          "text": "１日に１２時間働かなくてはならない。",
          "grammar_highlight": false
        }
      ],
      "reading": "そのしごとはじゅうぶんにおかねになるが、そのはんめん１にちに１２じかんはたらかなくてはならない。",
      "credits_raw": "PaulO",
      "translations": [
        {
          "language": "en",
          "text": "The job pays well, but on the other hand I have to work twelve hours a day.",
          "html": "<span>The job pays well, </span><strong>but on the other hand </strong><span>I have to work twelve hours a day. </span>",
          "segments": [
            {
              "text": "The job pays well, ",
              "grammar_highlight": false
            },
            {
              "text": "but on the other hand ",
              "grammar_highlight": true
            },
            {
              "text": "I have to work twelve hours a day. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
