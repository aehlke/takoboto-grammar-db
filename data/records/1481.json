      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%93%e3%81%ae\"><span>この</span></a><a href=\"https://takoboto.jp/?q=%e5%b8%83%e3%81%af\"><span>布は</span></a><a href=\"https://takoboto.jp/?q=%e6%b0%b4%e3%81%ab\"><span>水に</span></a><a href=\"https://takoboto.jp/?q=%e5%bc%b7%e3%81%84\"><span>強い</span></a><a href=\"https://takoboto.jp/?q=%e5%8f%8d%e9%9d%a2\"><strong>反面</strong></a><a href=\"https://takoboto.jp/?q=%2c\"><span>,</span></a><a href=\"https://takoboto.jp/?q=%e7%86%b1%e3%81%ab%e3%81%af\"><span>熱には</span></a><a href=\"https://takoboto.jp/?q=%e5%bc%b1%e3%81%84.\"><span>弱い.</span></a>",
