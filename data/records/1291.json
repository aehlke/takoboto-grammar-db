  "comments": [
    {
      "position": 0,
      "source_id": null,
      "text": "Formal. Kiwamaru and kiwamarinai are exactly the same meaning and can be used interchangeably. Kiwamatte is also the same meaning, but is used as a conjunction and is often used with the word感 (かん, feeling).\n\nsee http://www.geocities.com/easykanji/jlptgrammar.html",
      "html": "Formal. Kiwamaru and kiwamarinai are exactly the same meaning and can be used interchangeably. Kiwamatte is also the same meaning, but is used as a conjunction and is often used with the word感 (かん, feeling).<br/><br/>see http://www.geocities.com/easykanji/jlptgrammar.html",
      "credits_raw": "dc",
      "content_sha256": "dfbe3255d4a332eba7048bc67c47b3c95aa3799e3d7cf4bfe609a05f140fd828",
      "original_created_at": null,
      "original_updated_at": null
