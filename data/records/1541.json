      "original_updated_at": null
    },
    {
      "source_id": 6503,
      "position": 3,
      "japanese": "手伝ってくれたからこそ、仕事が早く出来ましたよ。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e6%89%8b%e4%bc%9d%e3%81%a3%e3%81%a6%e3%81%8f%e3%82%8c%e3%81%9f\"><span>手伝ってくれた</span></a><a href=\"https://takoboto.jp/?q=%e3%81%8b%e3%82%89%e3%81%93%e3%81%9d\"><strong>からこそ</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%81\"><span>、</span></a><a href=\"https://takoboto.jp/?q=%e4%bb%95%e4%ba%8b%e3%81%8c\"><span>仕事が</span></a><a href=\"https://takoboto.jp/?q=%e6%97%a9%e3%81%8f\"><span>早く</span></a><a href=\"https://takoboto.jp/?q=%e5%87%ba%e6%9d%a5%e3%81%be%e3%81%97%e3%81%9f%e3%82%88%e3%80%82\"><span>出来ましたよ。</span></a>",
      "segments": [
        {
