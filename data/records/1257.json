      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%80%81%e3%81%84%e3%82%82\"><span>老いも</span></a><a href=\"https://takoboto.jp/?q=%e8%8b%a5%e3%81%8d%e3%82%82%e3%80%81%e3%81%be%e3%81%9f\"><span>若きも、また</span></a><a href=\"https://takoboto.jp/?q=%e7%94%b7%e5%a5%b3%e3%82%92\"><span>男女を</span></a><a href=\"https://takoboto.jp/?q=%e5%95%8f%e3%82%8f%e3%81%9a%e3%80%81\"><strong>問わず、</strong></a><a href=\"https://takoboto.jp/?q=%e5%9c%b0%e5%85%83%e3%81%ae\"><span>地元の</span></a><a href=\"https://takoboto.jp/?q=%e6%b5%b4%e5%a0%b4%e3%81%a7\"><span>浴場で</span></a><a href=\"https://takoboto.jp/?q=%e4%b8%80%e7%b7%92%e3%81%ab%e3%81%aa%e3%82%8b%e3%81%93%e3%81%a8%e3%82%92\"><span>一緒になることを</span></a><a href=\"https://takoboto.jp/?q=%e6%a5%bd%e3%81%97%e3%81%bf%e3%81%ab%e3%81%97%e3%81%a6%e3%81%84%e3%81%9f%e3%80%82\"><span>楽しみにしていた。</span></a>",
      "segments": [
        {
          "text": "老いも若きも、また男女を",
          "grammar_highlight": false
        },
        {
          "text": "問わず、",
          "grammar_highlight": true
        },
        {
          "text": "地元の浴場で一緒になることを楽しみにしていた。",
          "grammar_highlight": false
        }
      ],
      "reading": "おいもわかきも、まただんじょをとわず、じもとのよくじょうでいっしょになることをたのしみにしていた。",
      "credits_raw": "Miki",
      "translations": [
