    {
      "source_id": 896,
      "position": 1,
      "japanese": "私が書いたかを問わず、(全て）「作者：あまつか」です。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e7%a7%81%e3%81%8c\"><span>私が</span></a><a href=\"https://takoboto.jp/?q=%e6%9b%b8%e3%81%84%e3%81%9f%e3%81%8b\"><span>書いたか</span></a><a href=\"https://takoboto.jp/?q=%e3%82%92%e5%95%8f%e3%82%8f%e3%81%9a\"><strong>を問わず</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%81(\"><span>、(</span></a><a href=\"https://takoboto.jp/?q=%e5%85%a8%e3%81%a6\"><span>全て</span></a><a href=\"https://takoboto.jp/?q=%ef%bc%89%e3%80%8c\"><span>）「</span></a><a href=\"https://takoboto.jp/?q=%e4%bd%9c%e8%80%85%ef%bc%9a%e3%81%82%e3%81%be%e3%81%a4%e3%81%8b%e3%80%8d%e3%81%a7%e3%81%99%e3%80%82\"><span>作者：あまつか」です。</span></a>",
      "segments": [
        {
          "text": "私が書いたか",
          "grammar_highlight": false
        },
        {
          "text": "を問わず",
          "grammar_highlight": true
        },
        {
          "text": "、(全て）「作者：あまつか」です。",
          "grammar_highlight": false
        }
      ],
      "reading": "わたしがかいたかをとわず、すべて）「さくしゃ：あまつか」です。",
      "credits_raw": "Amatuka",
      "translations": [
        {
          "language": "en",
          "text": "It's (always) [Author : Amatuka] whether I wrote it or not.",
          "html": "<span>It's (always) [Author : Amatuka] </span><strong>whether </strong><span>I wrote it </span><strong>or not. </strong>",
          "segments": [
            {
              "text": "It's (always) [Author : Amatuka] ",
              "grammar_highlight": false
            },
            {
              "text": "whether ",
              "grammar_highlight": true
            },
            {
              "text": "I wrote it ",
              "grammar_highlight": false
            },
            {
              "text": "or not. ",
              "grammar_highlight": true
            }
