    {
      "source_id": 4347,
      "position": 6,
      "japanese": "肌の色のいかんを問わず、彼は万人の言論の自由を擁護した。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%82%8c%e3%81%ae\"><span>肌の</span></a><a href=\"https://takoboto.jp/?q=%e8%89%b2%e3%81%ae\"><span>色の</span></a><a href=\"https://takoboto.jp/?q=%e3%81%84%e3%81%8b%e3%82%93%e3%82%92\"><span>いかんを</span></a><a href=\"https://takoboto.jp/?q=%e5%95%8f%e3%82%8f%e3%81%9a%e3%80%81\"><strong>問わず、</strong></a><a href=\"https://takoboto.jp/?q=%e5%bd%bc%e3%81%af\"><span>彼は</span></a><a href=\"https://takoboto.jp/?q=%e4%b8%87%e4%ba%ba%e3%81%ae\"><span>万人の</span></a><a href=\"https://takoboto.jp/?q=%e8%a8%80%e8%ab%96%e3%81%ae\"><span>言論の</span></a><a href=\"https://takoboto.jp/?q=%e8%87%aa%e7%94%b1%e3%82%92\"><span>自由を</span></a><a href=\"https://takoboto.jp/?q=%e6%93%81%e8%ad%b7%e3%81%97%e3%81%9f%e3%80%82\"><span>擁護した。</span></a>",
      "segments": [
        {
          "text": "肌の色のいかんを",
          "grammar_highlight": false
        },
        {
          "text": "問わず、",
          "grammar_highlight": true
        },
        {
          "text": "彼は万人の言論の自由を擁護した。",
          "grammar_highlight": false
        }
      ],
      "reading": "はだのいろのいかんをとわず、かれはまんにんのげんろんのじゆうをようごした。",
      "credits_raw": "Miki",
      "translations": [
        {
          "language": "en",
          "text": "He stood for freedom of speech for everyone regardless of color.",
          "html": "<span>He stood for freedom of speech for everyone regardless of color. </span>",
          "segments": [
            {
              "text": "He stood for freedom of speech for everyone regardless of color. ",
              "grammar_highlight": false
            }
          ]
        }
