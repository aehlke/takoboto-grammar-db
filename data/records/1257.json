    {
      "source_id": 3082,
      "position": 2,
      "japanese": "著作権表示があると否とを問わず真実の作者は法律上当然著作権者になります。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%91%97%e4%bd%9c%e6%a8%a9%e8%a1%a8%e7%a4%ba%e3%81%8c%e3%81%82%e3%82%8b%e3%81%a8\"><span>著作権表示があると</span></a><a href=\"https://takoboto.jp/?q=%e5%90%a6%e3%81%a8%e3%82%92\"><span>否とを</span></a><a href=\"https://takoboto.jp/?q=%e5%95%8f%e3%82%8f%e3%81%9a\"><strong>問わず</strong></a><a href=\"https://takoboto.jp/?q=%e7%9c%9f%e5%ae%9f%e3%81%ae\"><span>真実の</span></a><a href=\"https://takoboto.jp/?q=%e4%bd%9c%e8%80%85%e3%81%af\"><span>作者は</span></a><a href=\"https://takoboto.jp/?q=%e6%b3%95%e5%be%8b%e4%b8%8a%e5%bd%93%e7%84%b6%e8%91%97%e4%bd%9c%e6%a8%a9%e8%80%85%e3%81%ab%e3%81%aa%e3%82%8a%e3%81%be%e3%81%99%e3%80%82\"><span>法律上当然著作権者になります。</span></a>",
      "segments": [
        {
          "text": "著作権表示があると否とを",
          "grammar_highlight": false
        },
        {
          "text": "問わず",
          "grammar_highlight": true
        },
        {
          "text": "真実の作者は法律上当然著作権者になります。",
          "grammar_highlight": false
        }
      ],
      "reading": "ちょさくけんひょうじがあるといなとをとわずしんじつのさくしゃはほうりつじょうとうぜんちょさくけんしゃになります。",
      "credits_raw": "bamboo4",
      "translations": [
        {
          "language": "en",
          "text": "Whether or not any copyright indication is made, the true author by operation of law becomes the copyright owner.",
          "html": "<strong>Whether or not </strong><span>any copyright indication is made, the true author by operation of law becomes the copyright owner. </span>",
          "segments": [
            {
              "text": "Whether or not ",
              "grammar_highlight": true
            },
            {
              "text": "any copyright indication is made, the true author by operation of law becomes the copyright owner. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 4344,
      "position": 3,
      "japanese": "その試合には国籍のいかんを問わず誰でも参加できる。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae\"><span>その</span></a><a href=\"https://takoboto.jp/?q=%e8%a9%a6%e5%90%88%e3%81%ab%e3%81%af\"><span>試合には</span></a><a href=\"https://takoboto.jp/?q=%e5%9b%bd%e7%b1%8d%e3%81%ae\"><span>国籍の</span></a><a href=\"https://takoboto.jp/?q=%e3%81%84%e3%81%8b%e3%82%93%e3%82%92\"><span>いかんを</span></a><a href=\"https://takoboto.jp/?q=%e5%95%8f%e3%82%8f%e3%81%9a\"><strong>問わず</strong></a><a href=\"https://takoboto.jp/?q=%e8%aa%b0%e3%81%a7%e3%82%82\"><span>誰でも</span></a><a href=\"https://takoboto.jp/?q=%e5%8f%82%e5%8a%a0%e3%81%a7%e3%81%8d%e3%82%8b%e3%80%82\"><span>参加できる。</span></a>",
      "segments": [
        {
          "text": "その試合には国籍のいかんを",
          "grammar_highlight": false
        },
        {
          "text": "問わず",
          "grammar_highlight": true
        },
        {
          "text": "誰でも参加できる。",
          "grammar_highlight": false
        }
      ],
      "reading": "そのしあいにはこくせきのいかんをとわずだれでもさんかできる。",
      "credits_raw": "Miki",
      "translations": [
        {
          "language": "en",
          "text": "Anyone can participate in the game, no matter what nationality they are.",
          "html": "<span>Anyone can participate in the game, no matter what nationality they are. </span>",
          "segments": [
            {
              "text": "Anyone can participate in the game, no matter what nationality they are. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
