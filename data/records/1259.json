      "segments": [
        {
          "text": "日本語のクラスは、テストの点数と今までの学習期間",
          "grammar_highlight": false
        },
        {
          "text": "をもとに",
          "grammar_highlight": true
        },
        {
          "text": "決定される。",
          "grammar_highlight": false
