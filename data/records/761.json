      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e8%87%aa%e5%88%86%e3%81%ae\"><span>自分の</span></a><a href=\"https://takoboto.jp/?q=%e8%a8%80%e8%aa%9e%e3%82%92\"><span>言語を</span></a><a href=\"https://takoboto.jp/?q=%e4%bb%96%e3%81%ae\"><span>他の</span></a><a href=\"https://takoboto.jp/?q=%e4%ba%ba%e3%81%9f%e3%81%a1%e3%81%ae\"><span>人たちの</span></a><a href=\"https://takoboto.jp/?q=%e8%a8%80%e8%aa%9e%e3%81%a8\"><span>言語と</span></a><a href=\"https://takoboto.jp/?q=%e5%90%8c%e3%81%98\"><span>同じ</span></a><a href=\"https://takoboto.jp/?q=%e3%82%88%e3%81%86%e3%81%ab%e3%81%99%e3%82%8b\"><strong>ようにする</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%9f%e3%82%81%e3%81%ab\"><span>ために</span></a><a href=\"https://takoboto.jp/?q=%e5%bf%85%e8%a6%81%e3%81%aa\"><span>必要な</span></a><a href=\"https://takoboto.jp/?q=%e5%a4%89%e6%9b%b4%e3%82%92\"><span>変更を</span></a><a href=\"https://takoboto.jp/?q=%e5%8a%a0%e3%81%88%e3%82%8b%e3%80%82\"><span>加える。</span></a>",
