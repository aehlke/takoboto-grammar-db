      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e5%bd%bc%e3%82%89%e3%81%8c\"><span>彼らが</span></a><a href=\"https://takoboto.jp/?q=%e4%b8%80%e6%97%a5%e3%81%ab\"><span>一日に</span></a><a href=\"https://takoboto.jp/?q=%e9%a3%9f%e3%81%b9%e3%82%8b\"><span>食べる</span></a><a href=\"https://takoboto.jp/?q=%e9%a3%9f%e3%81%b9\"><span>食べ</span></a><a href=\"https://takoboto.jp/?q=%e7%89%a9%e3%81%ae\"><span>物の</span></a><a href=\"https://takoboto.jp/?q=%e9%87%8f%e3%81%af%e3%80%81\"><span>量は、</span></a><a href=\"https://takoboto.jp/?q=%e5%bd%bc%e3%82%89%e3%81%ae\"><span>彼らの</span></a><a href=\"https://takoboto.jp/?q=%e4%bd%93%e9%87%8d\"><span>体重</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e7%9b%b8%e5%bd%93%e3%81%97%e3%81%a6%e3%81%84%e3%82%8b\"><strong>に相当している</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%82\"><span>。</span></a>",
      "segments": [
        {
          "text": "彼らが一日に食べる食べ物の量は、彼らの体重",
          "grammar_highlight": false
        },
        {
          "text": "に相当している",
          "grammar_highlight": true
