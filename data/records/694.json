  "comments": [
    {
      "position": 0,
      "source_id": null,
      "text": "どうして must end with <b>んです</b> instead of まです form",
      "html": "どうして must end with &lt;b&gt;んです&lt;/b&gt; instead of まです form",
      "credits_raw": "natsumi",
      "content_sha256": "fbb121e17d8d59c4484acd36c59a283ee9c7d7ffc6644983ac594fde1430941e",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 1,
      "source_id": null,
      "text": "See the meaning of どう at \"ka dou ka.\"",
      "html": "See the meaning of どう at \"ka dou ka.\"",
      "credits_raw": "bamboo4",
      "content_sha256": "7bafd366e89e87e0c054ae359f987c87ea3b0e7fc88a180a1ed78abd7a6b9bdb",
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 2,
      "source_id": null,
      "text": "which is here kadouka",
      "html": "which is here kadouka",
      "credits_raw": "dc",
      "content_sha256": "2c3238f7a9796b85b244e34d26c04f718785ac60e93ae111af5784cf42653a2e",
