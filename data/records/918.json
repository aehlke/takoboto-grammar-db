    {
      "position": 1,
      "source_id": null,
      "text": "を契機に is very formal. also see ついでに - much more common in real speech",
      "html": "を契機に is very formal. also see ついでに - much more common in real speech",
      "credits_raw": "dc",
      "content_sha256": "f35fa42dc8347b691a904a346c676bb31393738680a38cbcdebfd82b136264eb",
