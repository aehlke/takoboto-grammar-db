      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e4%bb%ae%e3%81%ab%e3%82%82\"><span>仮にも</span></a><a href=\"https://takoboto.jp/?q=%e7%82%ba%e3%81%99\"><span>為す</span></a><a href=\"https://takoboto.jp/?q=%e4%be%a1%e5%80%a4%e3%81%8c%e3%81%82%e3%82%8b\"><span>価値がある</span></a><a href=\"https://takoboto.jp/?q=%e3%82%82%e3%81%ae%e3%81%aa%e3%82%89\"><strong>ものなら</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%b0\"><span>ば</span></a><a href=\"https://takoboto.jp/?q=%e4%bd%95%e3%81%a7%e3%82%82\"><span>何でも</span></a><a href=\"https://takoboto.jp/?q=%e8%89%af%e3%81%8f\"><span>良く</span></a><a href=\"https://takoboto.jp/?q=%e7%82%ba%e3%81%99\"><span>為す</span></a><a href=\"https://takoboto.jp/?q=%e4%be%a1%e5%80%a4%e3%81%8c%e3%81%82%e3%82%8b%e3%80%82\"><span>価値がある。</span></a>",
      "segments": [
        {
          "text": "仮にも為す価値がある",
          "grammar_highlight": false
        },
        {
          "text": "ものなら",
          "grammar_highlight": true
