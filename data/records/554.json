    {
      "source_id": 595,
      "position": 6,
      "japanese": "他国を侵略したからにはその責任をとるべきだ。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e4%bb%96%e5%9b%bd%e3%82%92\"><span>他国を</span></a><a href=\"https://takoboto.jp/?q=%e4%be%b5%e7%95%a5\"><span>侵略</span></a><a href=\"https://takoboto.jp/?q=%e3%81%97%e3%81%9f\"><span>した</span></a><a href=\"https://takoboto.jp/?q=%e3%81%8b%e3%82%89%e3%81%ab%e3%81%af\"><strong>からには</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae\"><span>その</span></a><a href=\"https://takoboto.jp/?q=%e8%b2%ac%e4%bb%bb%e3%82%92%e3%81%a8%e3%82%8b%e3%81%b9%e3%81%8d%e3%81%a0%e3%80%82\"><span>責任をとるべきだ。</span></a>",
      "segments": [
        {
          "text": "他国を侵略した",
          "grammar_highlight": false
        },
        {
          "text": "からには",
          "grammar_highlight": true
        },
        {
          "text": "その責任をとるべきだ。",
          "grammar_highlight": false
        }
      ],
      "reading": "たこくをしんりゃくしたからにはそのせきにんをとるべきだ。",
      "credits_raw": "dc",
      "translations": [
