    {
      "source_id": 4917,
      "position": 3,
      "japanese": "約束したからには、守っていただきます。守らなければ死んでもらいます。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e7%b4%84%e6%9d%9f%e3%81%97%e3%81%9f\"><span>約束した</span></a><a href=\"https://takoboto.jp/?q=%e3%81%8b%e3%82%89%e3%81%ab%e3%81%af%e3%80%81\"><strong>からには、</strong></a><a href=\"https://takoboto.jp/?q=%e5%ae%88%e3%81%a3%e3%81%a6%e3%81%84%e3%81%9f%e3%81%a0%e3%81%8d%e3%81%be%e3%81%99%e3%80%82\"><span>守っていただきます。</span></a><a href=\"https://takoboto.jp/?q=%e5%ae%88%e3%82%89%e3%81%aa%e3%81%91%e3%82%8c%e3%81%b0\"><span>守らなければ</span></a><a href=\"https://takoboto.jp/?q=%e6%ad%bb%e3%82%93%e3%81%a7%e3%82%82%e3%82%89%e3%81%84%e3%81%be%e3%81%99%e3%80%82\"><span>死んでもらいます。</span></a>",
      "segments": [
        {
          "text": "約束した",
          "grammar_highlight": false
        },
        {
          "text": "からには、",
          "grammar_highlight": true
        },
        {
          "text": "守っていただきます。守らなければ死んでもらいます。",
          "grammar_highlight": false
        }
      ],
      "reading": "やくそくしたからには、まもっていただきます。まもらなければしんでもらいます。",
      "credits_raw": "Pan",
      "translations": [
        {
          "language": "en",
          "text": "As/in that you have made a promise, please keep it. If you don't, die for me.",
          "html": "<strong>As/in that </strong><span>you have made a promise, please keep it. If you don't, die for me. </span>",
          "segments": [
            {
              "text": "As/in that ",
              "grammar_highlight": true
            },
            {
              "text": "you have made a promise, please keep it. If you don't, die for me. ",
              "grammar_highlight": false
            }
          ]
        }
