    {
      "source_id": 4245,
      "position": 2,
      "japanese": "この農園は私たちの必要を満たすに足るだけの野菜を産出する。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%93%e3%81%ae\"><span>この</span></a><a href=\"https://takoboto.jp/?q=%e8%be%b2%e5%9c%92%e3%81%af\"><span>農園は</span></a><a href=\"https://takoboto.jp/?q=%e7%a7%81%e3%81%9f%e3%81%a1%e3%81%ae\"><span>私たちの</span></a><a href=\"https://takoboto.jp/?q=%e5%bf%85%e8%a6%81%e3%82%92\"><span>必要を</span></a><a href=\"https://takoboto.jp/?q=%e6%ba%80%e3%81%9f%e3%81%99\"><span>満たす</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e8%b6%b3%e3%82%8b\"><strong>に足る</strong></a><a href=\"https://takoboto.jp/?q=%e3%81%a0%e3%81%91%e3%81%ae\"><span>だけの</span></a><a href=\"https://takoboto.jp/?q=%e9%87%8e%e8%8f%9c%e3%82%92\"><span>野菜を</span></a><a href=\"https://takoboto.jp/?q=%e7%94%a3%e5%87%ba%e3%81%99%e3%82%8b%e3%80%82\"><span>産出する。</span></a>",
      "segments": [
        {
          "text": "この農園は私たちの必要を満たす",
          "grammar_highlight": false
        },
        {
          "text": "に足る",
          "grammar_highlight": true
        },
        {
          "text": "だけの野菜を産出する。",
          "grammar_highlight": false
        }
      ],
      "reading": "こののうえんはわたしたちのひつようをみたすにたるだけのやさいをさんしゅつする。",
      "credits_raw": "dc",
      "translations": [
        {
          "language": "en",
          "text": "This farm yields enough vegetables to meet our needs.",
          "html": "<span>This farm yields enough vegetables to meet our needs. </span>",
          "segments": [
            {
              "text": "This farm yields enough vegetables to meet our needs. ",
              "grammar_highlight": false
            }
          ]
        }
      ],
