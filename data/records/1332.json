      "segments": [
        {
          "text": "ビルは印刷業でいい暮らしをする",
          "grammar_highlight": false
        },
        {
          "text": "に足る",
          "grammar_highlight": true
        },
        {
          "text": "お金をかせいだ。",
          "grammar_highlight": false
        }
