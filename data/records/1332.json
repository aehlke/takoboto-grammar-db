      "segments": [
        {
          "text": "いやしくもなす",
          "grammar_highlight": false
        },
        {
          "text": "に足る",
          "grammar_highlight": true
        },
        {
          "text": "事なら立派にやるだけの価値がある。",
          "grammar_highlight": false
        }
