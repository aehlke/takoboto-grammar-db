      "segments": [
        {
          "text": "少し悪いと思い",
          "grammar_highlight": false
        },
        {
          "text": "ながらも",
          "grammar_highlight": true
        },
        {
          "text": "、彼は笑うのを抑えることはできなかった。",
          "grammar_highlight": false
        }
      ],
      "reading": "すこしわるいとおもいながらも、かれはわらうのをおさえることはできなかった。",
      "credits_raw": "dc",
      "translations": [
        {
