      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e3%81%9d%e3%81%ae\"><span>その</span></a><a href=\"https://takoboto.jp/?q=%e8%81%b7%e4%ba%ba%e3%81%af\"><span>職人は</span></a><a href=\"https://takoboto.jp/?q=%e5%8f%a4%e3%81%84\"><span>古い</span></a><a href=\"https://takoboto.jp/?q=%e4%bc%9d%e8%aa%ac%e3%82%92\"><span>伝説を</span></a><a href=\"https://takoboto.jp/?q=%e5%ae%88%e3%82%8a\"><span>守り</span></a><a href=\"https://takoboto.jp/?q=%e3%81%aa%e3%81%8c%e3%82%89%e3%82%82\"><strong>ながらも</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%81\"><span>、</span></a><a href=\"https://takoboto.jp/?q=%e6%96%b0%e3%81%97%e3%81%84\"><span>新しい</span></a><a href=\"https://takoboto.jp/?q=%e5%b7%a5%e5%a4%ab%e3%82%92\"><span>工夫を</span></a><a href=\"https://takoboto.jp/?q=%e9%87%8d%e3%81%ad%e3%81%a6%e3%81%84%e3%82%8b\"><span>重ねている</span></a>",
      "segments": [
