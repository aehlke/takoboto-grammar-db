      "segments": [
        {
          "text": "眼鏡の形をしている",
          "grammar_highlight": false
        },
        {
          "text": "ことから",
          "grammar_highlight": true
        },
        {
          "text": "、その橋を眼鏡橋とよぶ。",
          "grammar_highlight": false
        }
      ],
      "reading": "めがねのかたちをしていることから、そのはしをめがねばしとよぶ。",
      "credits_raw": "dc, bamboo4",
