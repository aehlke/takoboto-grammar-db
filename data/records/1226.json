      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 7917,
      "position": 2,
      "japanese": "納入した学費は理由のいかんに関わらず返却しません。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e7%b4%8d%e5%85%a5%e3%81%97%e3%81%9f\"><span>納入した</span></a><a href=\"https://takoboto.jp/?q=%e5%ad%a6%e8%b2%bb%e3%81%af\"><span>学費は</span></a><a href=\"https://takoboto.jp/?q=%e7%90%86%e7%94%b1\"><span>理由</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ae\"><span>の</span></a><a href=\"https://takoboto.jp/?q=%e3%81%84%e3%81%8b%e3%82%93%e3%81%ab%e9%96%a2%e3%82%8f%e3%82%89%e3%81%9a\"><strong>いかんに関わらず</strong></a><a href=\"https://takoboto.jp/?q=%e8%bf%94%e5%8d%b4%e3%81%97%e3%81%be%e3%81%9b%e3%82%93%e3%80%82\"><span>返却しません。</span></a>",
      "segments": [
        {
          "text": "納入した学費は理由の",
          "grammar_highlight": false
        },
        {
          "text": "いかんに関わらず",
          "grammar_highlight": true
        },
        {
          "text": "返却しません。",
          "grammar_highlight": false
        }
      ],
      "reading": "のうにゅうしたがくひはりゆうのいかんにかかわらずへんきゃくしません。",
      "credits_raw": "LR",
