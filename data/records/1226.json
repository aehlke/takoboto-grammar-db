          "html": "<span>The number of municipalities where one can take the employment test </span><strong>regardless of </strong><span>nationalty is increasing. </span>",
          "segments": [
            {
              "text": "The number of municipalities where one can take the employment test ",
              "grammar_highlight": false
            },
            {
              "text": "regardless of ",
              "grammar_highlight": true
            },
            {
              "text": "nationalty is increasing. ",
              "grammar_highlight": false
            }
