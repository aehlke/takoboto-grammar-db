      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 2,
      "source_id": null,
      "text": "Ref # Kanzen Master Level 1 - p40 - no.35",
      "html": "<b>Ref #</b> Kanzen Master Level 1 - p40 - no.35",
