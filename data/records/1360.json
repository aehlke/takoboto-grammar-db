      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e9%a3%9b%e8%a1%8c%e6%a9%9f%e3%81%af\"><span>飛行機は</span></a><a href=\"https://takoboto.jp/?q=%e6%80%a5%e8%a7%92%e5%ba%a6%e3%81%a7\"><span>急角度で</span></a><a href=\"https://takoboto.jp/?q=%e4%b8%8a%e6%98%87%e3%81%97%e3%80%81%e3%81%9d%e3%82%8c%e3%81%8b%e3%82%89\"><span>上昇し、それから</span></a><a href=\"https://takoboto.jp/?q=%e6%b5%b7%e5%b2%b8%e3%82%92\"><span>海岸を</span></a><a href=\"https://takoboto.jp/?q=%e9%9b%a2%e3%82%8c%e3%82%8b\"><span>離れる</span></a><a href=\"https://takoboto.jp/?q=%e3%81%ab%e3%81%a4%e3%82%8c%e3%81%a6\"><strong>につれて</strong></a><a href=\"https://takoboto.jp/?q=%e6%b0%b4%e5%b9%b3%e9%a3%9b%e8%a1%8c%e3%81%ab\"><span>水平飛行に</span></a><a href=\"https://takoboto.jp/?q=%e7%a7%bb%e3%81%a3%e3%81%9f%e3%80%82\"><span>移った。</span></a>",
      "segments": [
