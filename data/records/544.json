    {
      "source_id": 6495,
      "position": 11,
      "japanese": "退院しましたが、病気が治って退院したわけではないんです。",
      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e9%80%80%e9%99%a2%e3%81%97%e3%81%be%e3%81%97%e3%81%9f%e3%81%8c%e3%80%81\"><span>退院しましたが、</span></a><a href=\"https://takoboto.jp/?q=%e7%97%85%e6%b0%97%e3%81%8c\"><span>病気が</span></a><a href=\"https://takoboto.jp/?q=%e6%b2%bb%e3%81%a3%e3%81%a6\"><span>治って</span></a><a href=\"https://takoboto.jp/?q=%e9%80%80%e9%99%a2%e3%81%97%e3%81%9f\"><span>退院した</span></a><a href=\"https://takoboto.jp/?q=%e3%82%8f%e3%81%91%e3%81%a7%e3%81%af%e3%81%aa%e3%81%84\"><strong>わけではない</strong></a><a href=\"https://takoboto.jp/?q=%e3%82%93%e3%81%a7%e3%81%99%e3%80%82\"><span>んです。</span></a>",
      "segments": [
        {
          "text": "退院しましたが、病気が治って退院した",
          "grammar_highlight": false
        },
        {
          "text": "わけではない",
          "grammar_highlight": true
        },
        {
          "text": "んです。",
          "grammar_highlight": false
        }
