      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "position": 4,
      "source_id": null,
      "text": "that might be the opposite of という訳で (for that reason) but also used for summing up meetings. See [wake]",
      "html": "that might be the opposite of という訳で (for that reason) but also used for summing up meetings. See [wake]",
