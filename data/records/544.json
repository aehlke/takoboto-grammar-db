      "japanese_html": "<a href=\"https://takoboto.jp/?q=%e4%ba%ba%e9%96%93%e3%81%af\"><span>人間は</span></a><a href=\"https://takoboto.jp/?q=%e5%83%8d%e3%81%8f%e3%81%9f%e3%82%81%e3%81%ab\"><span>働くために</span></a><a href=\"https://takoboto.jp/?q=%e7%94%9f%e3%81%be%e3%82%8c%e3%81%a6%e3%81%8d%e3%81%9f\"><span>生まれてきた</span></a><a href=\"https://takoboto.jp/?q=%e3%82%8f%e3%81%91%e3%81%a7%e3%81%af%e3%81%aa%e3%81%84\"><strong>わけではない</strong></a><a href=\"https://takoboto.jp/?q=%e3%80%82\"><span>。</span></a>",
