  "examples": [
    {
      "source_id": 1226,
      "position": 0,
      "japanese": "あの人は学者というよりむしろ政治家だ。",
      "body_text": "あの人は学者というよりむしろ政治家だ。 \n\nIf anything, \n\t\the is a politician rather than a scholar.",
      "body_html": "<a href=\"http://www.csse.monash.edu.au/~jwb/cgi-bin/wwwjdic.cgi?9MHJあの人は学者というよりむしろ政治家だ。\">\nあの人は学者というより<strong>むしろ</strong>政治家だ。<strong></strong></a> <br/>\n<strong>If anything, </strong>\n\t\the is a politician rather than a scholar.",
      "credits_raw": "bamboo4",
      "verification_class": [
        "bottom"
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 2946,
      "position": 1,
      "japanese": "金持ちになるよりむしろ貧乏でいる方がいい。",
      "body_text": "金持ちになるよりむしろ貧乏でいる方がいい。 \n\nRather than \n\t\tbeing rich, I prefer to be poor.",
      "body_html": "<a href=\"http://www.csse.monash.edu.au/~jwb/cgi-bin/wwwjdic.cgi?9MHJ金持ちになるよりむしろ貧乏でいる方がいい。\">\n\t\t\t\t金持ちになるより<strong>むしろ</strong>貧乏でいる方がいい。<strong></strong></a> <br/>\n<strong>Rather than </strong>\n\t\tbeing rich, I prefer to be poor.",
      "credits_raw": "Amatuka",
      "verification_class": [
        "bottom"
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 4982,
      "position": 2,
      "japanese": "とてもすばらしい天気だったのでむしろ歩きたいと思った。",
      "body_text": "とてもすばらしい天気だったのでむしろ歩きたいと思った。 \n\n\t\tIt was so lovely a day that I preferred to walk (Rather than some other means of transportation).",
      "body_html": "<a href=\"http://www.csse.monash.edu.au/~jwb/cgi-bin/wwwjdic.cgi?9MHJとてもすばらしい天気だったのでむしろ歩きたいと思った。\">\n\t\t\t\tとてもすばらしい天気だったので<strong>むしろ</strong>歩きたいと思った。<strong></strong></a> <br/>\n\t\tIt was so lovely a day that I preferred to walk (Rather than some other means of transportation). \n\t\t<strong> </strong>",
      "credits_raw": "LittleFish",
      "verification_class": [
        "bottom"
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 8289,
      "position": 3,
      "japanese": "彼女は女優というよりもむしろ歌手だ。",
      "body_text": "彼女は女優というよりもむしろ歌手だ。\r \n\n\t\tShe is a singer rather than an actress.",
      "body_html": "<a href=\"http://www.csse.monash.edu.au/~jwb/cgi-bin/wwwjdic.cgi?9MHJ彼女は女優というよりもむしろ歌手だ。\">\n\t\t\t\t彼女は女優というよりも<strong>むしろ</strong>歌手だ。\r<strong></strong></a> <br/>\n\t\tShe is a singer rather than an actress. \n\t\t<strong> </strong>",
      "credits_raw": "karekano",
      "verification_class": [
        "bottom"
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 8290,
      "position": 4,
      "japanese": "彼らは外車よりむしろ日本の車を買う。",
      "body_text": "彼らは外車よりむしろ日本の車を買う。\r \n\n\t\tThey buy Japanese rather than foreign cars.",
      "body_html": "<a href=\"http://www.csse.monash.edu.au/~jwb/cgi-bin/wwwjdic.cgi?9MHJ彼らは外車よりむしろ日本の車を買う。\">\n\t\t\t\t彼らは外車より<strong>むしろ</strong>日本の車を買う。\r<strong></strong></a> <br/>\n\t\tThey buy Japanese rather than foreign cars. \n\t\t<strong> </strong>",
      "credits_raw": "karekano",
      "verification_class": [
        "bottom"
      ],
      "original_created_at": null,
      "original_updated_at": null
    },
    {
      "source_id": 8291,
      "position": 5,
      "japanese": "公園へ行くよりむしろ動物園へ行きたい。",
      "body_text": "公園へ行くよりむしろ動物園へ行きたい。\r \n\n\t\tWe would rather go to the zoo than to the park.",
      "body_html": "<a href=\"http://www.csse.monash.edu.au/~jwb/cgi-bin/wwwjdic.cgi?9MHJ公園へ行くよりむしろ動物園へ行きたい。\">\n\t\t\t\t公園へ行くより<strong>むしろ</strong>動物園へ行きたい。\r<strong></strong></a> <br/>\n\t\tWe would rather go to the zoo than to the park. \n\t\t<strong> </strong>",
      "credits_raw": "karekano",
      "verification_class": [
        "bottom"
      ],
      "original_created_at": null,
      "original_updated_at": null
    }
